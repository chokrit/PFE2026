@startuml auth_cas_utilisation
' ============================================================
' Diagramme de cas d'utilisation — Module Authentification
' Application EVENT — PFE
' ============================================================

left to right direction

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #3730A3
  ArrowColor #374151
  FontSize 12
}

skinparam actor {
  BackgroundColor White
  BorderColor #374151
  FontSize 12
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #374151
  FontSize 14
  FontStyle bold
}

' ══════════════════════════════════
' ACTEURS (colonne gauche)
' ══════════════════════════════════

:Utilisateur: as U
:Organisateur: as O
:Administrateur: as A

' Héritage des acteurs — triangle vide pointant vers le parent
U <|-- O
O <|-- A

' ══════════════════════════════════
' FRONTIÈRE DU SYSTÈME
' ══════════════════════════════════

rectangle "Application EVENT" {

  usecase "S'inscrire\n(créer un compte)" as UC1
  usecase "Se connecter" as UC2
  usecase "Valider token JWT" as UC3
  usecase "Gérer son profil" as UC4
  usecase "Uploader photo\n(Cloudinary)" as UC5
  usecase "Réinitialiser le\nmot de passe" as UC6
  usecase "Choisir la langue" as UC7
  usecase "Gérer les comptes\nutilisateurs" as UC8
  usecase "Consulter le\ntableau de bord" as UC9

  ' <<include>> : Se connecter déclenche toujours Valider token JWT
  UC2 .> UC3 : <<include>>

  ' <<extend>> : Uploader photo est optionnel dans Gérer son profil
  UC5 .> UC4 : <<extend>>
}

' ══════════════════════════════════
' ASSOCIATIONS ACTEURS ↔ CAS D'UTILISATION
' ══════════════════════════════════

' Utilisateur (acteur de base)
U --> UC1
U --> UC2
U --> UC4
U --> UC6
U --> UC7
U --> UC9

' Organisateur (hérite de Utilisateur — connexions supplémentaires explicites)
O --> UC2
O --> UC9

' Administrateur (hérite de Organisateur)
A --> UC2
A --> UC8
A --> UC9

@enduml
